# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo .env real para o Git.

# String de conexão do PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/aso_control?schema=public"

# Porta em que a API vai rodar
PORT=3333

# "development" ou "production". Em produção, respostas de erro não expõem detalhes técnicos.
NODE_ENV=development

# Segredo usado para assinar os tokens JWT.
# NUNCA use o valor de exemplo abaixo. Gere um valor aleatório rodando no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque_isso_por_uma_string_aleatoria_bem_grande"
JWT_EXPIRES_IN="8h"

# URL do frontend, usada para liberar CORS
FRONTEND_URL="http://localhost:5173"

# Horário em que o robô de verificação de ASOs roda todo dia (formato cron)
# Padrão: todo dia às 08:00. Usado apenas se você depender do robô interno (node-cron).
CRON_SCHEDULE="0 8 * * *"

# Chave secreta usada por um serviço externo de cron (ex: cron-job.org) para
# disparar a verificação de ASOs via POST /api/cron/run-check, sem precisar de login.
# Gere um valor aleatório assim: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obrigatória em produção (NODE_ENV=production).
CRON_SECRET="troque_isso_por_uma_string_aleatoria"
